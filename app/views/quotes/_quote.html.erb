<li id="quote-<%= quote.id %>">
  <%= link_to gravatar_for(quote.author, size: 50), quote.author %>
  <span class="user"><%= link_to quote.author.name, quote.author %></span>
  <span class="content">
    <%= quote.content %>
    <%= image_tag quote.image if quote.image.attached? %>
  </span>
  <span class="timestamp">
    Posted <%= time_ago_in_words(quote.created_at) %> ago.
    <% if current_member?(quote.author) %>
      <%= link_to "delete", quote, data: { "turbo-method": :delete,
                                          turbo_confirm: "You sure?" },
                                   class: "text-danger" %>
    <% end %>
  </span>
</li>
